{
  "expo": {
    "name": "MyLittleMuslim",
    "slug": "ramadan-tracker",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/expo-icon.png",
    "scheme": "mylittlemuslim",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/7fc94f0a-95c3-458a-933c-1f4f230a1e7d",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiment": {
      "newArchitecture": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aj686.ramadantracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/expo-icon.png",
        "backgroundImage": "./assets/images/expo-icon.png",
        "monochromeImage": "./assets/images/expo-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aj686.ramadantracker",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#22C55E"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#22C55E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7fc94f0a-95c3-458a-933c-1f4f230a1e7d"
      }
    }
  }
}
